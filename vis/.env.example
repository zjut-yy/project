# Copy this file to .env and edit local paths before running services.
# Do not commit .env; it may contain local paths or API keys.

# Backend API
AGENT_HOST=0.0.0.0
AGENT_PORT=8010
DISABLE_MODEL=0
DEFAULT_FPS=30.0

# Local model and dataset roots. These directories are intentionally git-ignored.
MODEL_ROOT=./backend/model
DATASET_ROOT=./backend/dataset
INTERNVIDEO_MODEL_PATH=./backend/model/InternVideo2.5
QWEN_MODEL_PATH=./backend/model/Qwen2.5-7B-Instruct

# Optional per-dataset overrides
VIRAT_DATASET_DIR=./backend/dataset/VIRAT
MEVA_DATASET_DIR=./backend/dataset/MEVA
WILDTRACK_DATASET_DIR=./backend/dataset/WildTrack
WILDTRACK_VIRAT_DATASET_DIR=./backend/dataset/WildTrack_VIRAT

# Two conda/env roots used by backend/start_all_services.sh.
# MINICPM_ENV should install requirements-minicpm.txt.
# VLLM_ENV should install requirements-vllm.txt.
VLLM_ENV=/path/to/vllm/env
MINICPM_ENV=/path/to/minicpm/env
VLLM_HOST=0.0.0.0
VLLM_PORT=8001
VLLM_URL=http://localhost:8001/v1
VLLM_MODEL_NAME=Qwen2.5-7B-Instruct
VLLM_GPU_MEMORY_UTILIZATION=0.5
VLLM_MAX_MODEL_LEN=4096
VLLM_DTYPE=float16

# Optional OpenAI-compatible API for garbage video pipeline
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=gemini-3.1-flash-image-preview
